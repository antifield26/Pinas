# 环境变量（含密码）
.env

# 自动生成的初始密码（修改密码后应删除）
credentials.txt

# 数据库文件（含 WAL/SHM 与备份）
*.db
*.db-shm
*.db-wal
backups/

# 编译产物
/target/

# 日志与运行时数据
/logs/
uploads/

# Node.js 依赖
/node_modules/

# IDE
/.vs/
*.swp
*.swo
*~

# Clast MCP 工具缓存
/.clast/

# Visual Studio Code
/.vscode/

# Tailwind CSS 编译输出（可由 npm run css:build 重新生成）
# assets/css/tailwind.min.css 通常建议提交以方便部署，取消下行注释可不提交:
# /assets/css/tailwind.min.css
